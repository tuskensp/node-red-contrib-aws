# Copy this file to .env and fill in what you have. See README.md for how to get each key.

# Needed for Spotify links: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: faster Discogs lookups and search by name: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional: producer/songwriter/musician credits from Genius: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=
